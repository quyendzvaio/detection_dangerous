# Local development only. Copy to .env and replace secrets outside development.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=industrial_safety_dev
POSTGRES_DB=industrial_safety
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000
ADMINER_PORT=8081
AI_SERVICE_TOKEN=local-ai-service-token-change-me
JWT_SECRET=local-jwt-secret-change-me

# AI process uses these values when publishing events to Layer 4.
BACKEND_EVENT_URL=http://localhost:8080/api/v1/internal/events
BACKEND_CAMERA_STATUS_URL=http://localhost:8080/api/v1/internal/camera-status

# Azure Blob Cloud stores evidence; PostgreSQL remains local.
# Copy the connection string from Azure Portal and keep it quoted because it contains semicolons.
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER=industrial-safety-evidence
# Optional for standard Azure Storage; leave blank so the SDK derives the endpoint.
AZURE_STORAGE_PUBLIC_BLOB_ENDPOINT=
AZURE_STORAGE_SAS_EXPIRES_SECONDS=900
AZURE_STORAGE_CREATE_CONTAINER=true

# auto/1/true requires a cloud connection string. Use 0 only when testing without evidence.
EVIDENCE_ENABLED=auto
EVIDENCE_SPOOL_DIR=evidence_spool

# Initial models for newly registered cameras. Existing camera settings in DB are preserved.
LAYER2_MODELS=zone,fall
RUNTIME_CONFIG_POLL_SECONDS=1
WEB_PREVIEW_FPS=10
