name: "yolo_pose"
backend: "onnxruntime"
max_batch_size: 4

input [
    {
        name: "images"
        data_type: TYPE_FP32
        dims: [3, 640, 640]
    }
]

output [
    {
        name: "output0"
        data_type: TYPE_FP32
        dims: [56, -1] 
    }
]

dynamic_batching {
    max_queue_delay_microseconds: 2000
}