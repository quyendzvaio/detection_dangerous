# ==============================================================================
# INDUSTRIAL SAFETY AI ANALYTICS - BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application settings
PROJECT_NAME="Industrial Safety AI Analytics API"
JWT_SECRET="super_secret_jwt_key_change_in_production_12345"
AI_SERVICE_TOKEN="replace_with_a_service_token"

# Database connection (PostgreSQL)
DATABASE_URL="postgresql+psycopg2://postgres:123456@localhost:5432/hit-product"

# Azure Blob Cloud stores evidence while PostgreSQL may remain local.
# Keep the connection string quoted because it contains semicolons.
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_STORAGE_CONTAINER="industrial-safety-evidence"
# Optional for standard Azure Storage; the SDK derives the endpoint when blank.
AZURE_STORAGE_PUBLIC_BLOB_ENDPOINT=""
AZURE_STORAGE_SAS_EXPIRES_SECONDS=900
AZURE_STORAGE_CREATE_CONTAINER=true

# Legacy/unused gRPC server port
GRPC_SERVER_PORT=50051
