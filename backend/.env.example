# Application Settings
PROJECT_NAME="Industrial Safety AI Analytics API"
JWT_SECRET="super_secret_jwt_key_change_in_production_12345"

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:123456@localhost:5432/hit-product"

# Cloudflare R2 Credentials (S3 Compatible Storage)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET="industrial-safety-evidence"

# gRPC AI Engine Server Port
GRPC_SERVER_PORT=50051
